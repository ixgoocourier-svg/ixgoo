rules_version = '2';

// Regole di sicurezza IxGoo: sono l'unica protezione dei dati, perché l'app gira nel browser.
//  - users/{uid}: profilo; il ruolo (cliente/corriere/admin) lo cambia solo un admin
//  - shipments/{codice}: il cliente crea e vede le sue; admin conferma/annulla;
//    admin e corriere registrano la consegna
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // "verificato": email confermata dal link, oppure utente approvato da un admin (campo approved)
    function verified() {
      return signedIn() && (request.auth.token.email_verified == true
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('approved', false) == true));
    }
    function profilePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function profile() { return get(profilePath()).data; }
    function hasRole(roles) {
      return verified() && exists(profilePath())
        && profile().get('active', true) == true && profile().role in roles;
    }
    function isAdmin() { return hasRole(['admin']); }
    function isStaff() { return hasRole(['admin', 'corriere']); }
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function nonEmpty(v) { return v is string && v.size() > 0 && v.size() <= 300; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());

      // registrazione: si nasce "cliente" e attivi; gli indirizzi qui sotto nascono "admin"
      // (i poteri da admin valgono solo dopo la conferma dell'email: vedi hasRole)
      allow create: if signedIn() && request.auth.uid == uid
        && (request.resource.data.role == 'cliente'
            || (request.resource.data.role == 'admin'
                && request.auth.token.email in ['ixgoo@outlook.com.gr', 'pierpaolomurgioni@gmail.com',
                                                'ixgoocourier@gmail.com']))
        && request.resource.data.active == true
        && request.resource.data.email == request.auth.token.email
        // nessuno si approva da solo, né dichiara l'email confermata se non lo è
        && request.resource.data.get('approved', false) == false
        && (request.resource.data.get('email_verified', false) == false || request.auth.token.email_verified == true);

      allow update: if signedIn() && (
        // il proprio profilo, senza toccare ruolo, stato o email
        // (email_verified si può segnare solo se Firebase conferma davvero l'email)
        (request.auth.uid == uid && onlyChanged(['ragione_sociale', 'nome', 'cognome',
            'indirizzo', 'cap', 'citta', 'provincia', 'telefono', 'lang', 'email_verified'])
            && (request.resource.data.get('email_verified', false) == false || request.auth.token.email_verified == true))
        // un admin cambia ruolo, attiva/disattiva o approva gli altri
        || (isAdmin() && request.auth.uid != uid && onlyChanged(['role', 'active', 'approved', 'approved_by', 'approved_at'])
            && request.resource.data.role in ['cliente', 'corriere', 'admin']
            && request.resource.data.active is bool
            && request.resource.data.get('approved', false) is bool)
      );

      // diritto alla cancellazione: ognuno può eliminare solo il proprio profilo
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // giro del corriere: ordine delle consegne scelto da ciascun corriere/admin, solo per sé
    match /routes/{uid} {
      allow read: if isStaff() && request.auth.uid == uid;
      allow create, update: if isStaff() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['order', 'updated_at'])
        && request.resource.data.order is list
        && request.resource.data.order.size() <= 500;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /shipments/{code} {
      allow read: if isStaff()
        || (verified() && resource.data.user_id == request.auth.uid);

      function validShipment(code) {
        return request.resource.data.code == code
          && code.matches('IXG-[0-9]{6}-[0-9A-F]{6}')
          && request.resource.data.delivered_by == null
          && request.resource.data.delivered_at == null
          && request.resource.data.tipo in ['busta', 'pacco']
          && request.resource.data.colli is int
          && request.resource.data.colli >= 1 && request.resource.data.colli <= 99;
      }

      allow create: if validShipment(code) && (
        // prenotazione di un cliente con email verificata: sempre "in attesa"
        (hasRole(['cliente'])
          && request.resource.data.user_id == request.auth.uid
          && request.resource.data.status == 'in_attesa'
          && request.resource.data.confirmed_by == null)
        // ordine inserito da un admin, per un cliente non registrato (user_id null) o per un cliente
        // registrato esistente (l'ordine compare nella sua area): già confermato
        || (isAdmin()
          && (request.resource.data.user_id == null
              || (request.resource.data.user_id is string
                  && exists(/databases/$(database)/documents/users/$(request.resource.data.user_id))))
          && request.resource.data.created_by == request.auth.uid
          && request.resource.data.status == 'confermata'
          && request.resource.data.confirmed_by == request.auth.uid)
      );

      allow update: if
        // il cliente annulla una sua richiesta non ancora confermata
        (verified() && resource.data.user_id == request.auth.uid
          && resource.data.status == 'in_attesa'
          && request.resource.data.status == 'annullata'
          && onlyChanged(['status', 'cancelled_at']))
        // l'admin conferma il ricevimento
        || (isAdmin() && resource.data.status == 'in_attesa'
          && request.resource.data.status == 'confermata'
          && request.resource.data.confirmed_by == request.auth.uid
          && onlyChanged(['status', 'confirmed_at', 'confirmed_by']))
        // l'admin annulla
        || (isAdmin() && resource.data.status in ['in_attesa', 'confermata']
          && request.resource.data.status == 'annullata'
          && onlyChanged(['status', 'cancelled_at', 'cancel_reason']))
        // admin o corriere registrano la consegna
        || (isStaff() && resource.data.status == 'confermata'
          && request.resource.data.status == 'consegnata'
          && request.resource.data.delivered_by == request.auth.uid
          && onlyChanged(['status', 'delivered_at', 'delivered_by']))
        // consegna registrata per errore: la annulla un admin o il corriere che l'ha registrata
        || (isStaff() && resource.data.status == 'consegnata'
          && (isAdmin() || resource.data.delivered_by == request.auth.uid)
          && request.resource.data.status == 'confermata'
          && request.resource.data.delivered_at == null
          && request.resource.data.delivered_by == null
          && onlyChanged(['status', 'delivered_at', 'delivered_by']))
        // modifica dei dati dell'ordine fino alla consegna: il cliente proprietario o un admin
        || (resource.data.status in ['in_attesa', 'confermata']
          && ((verified() && resource.data.user_id == request.auth.uid) || isAdmin())
          && request.resource.data.updated_by == request.auth.uid
          && request.resource.data.tipo in ['busta', 'pacco']
          && request.resource.data.colli is int
          && request.resource.data.colli >= 1 && request.resource.data.colli <= 99
          && onlyChanged(['mitt_ragione_sociale', 'mitt_nome', 'mitt_cognome', 'mitt_telefono', 'mitt_email',
              'pickup_date', 'pickup_time', 'pickup_indirizzo', 'pickup_cap', 'pickup_citta', 'pickup_provincia',
              'dest_nome', 'dest_indirizzo', 'dest_cap', 'dest_citta', 'dest_provincia', 'dest_ref_nome',
              'dest_ref_telefono', 'tipo', 'colli', 'peso', 'note', 'updated_at', 'updated_by']));

      allow delete: if false;
    }
  }
}
